# Supabase: Project Settings → Database → Connection string → URI.
# Use the session pooler (port 5432), not the transaction pooler (port 6543).
# URL-encode special characters in the password. The app accepts postgresql:// too.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Multimodal understanding (text + optional image). JSON mode.
GROQ_API_KEY=gsk_your_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embeddings. Groq does not currently serve /v1/embeddings, so this is a
# separate OpenAI-compatible host. The API measures the real vector length
# and refuses to mix dimensions or models in one database.
# OpenAI example:
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk_your_key
EMBEDDING_MODEL=text-embedding-3-small
# Jina example (v3 needs a task):
# EMBEDDING_BASE_URL=https://api.jina.ai/v1
# EMBEDDING_API_KEY=jina_your_key
# EMBEDDING_MODEL=jina-embeddings-v3
# EMBEDDING_TASK=text-matching
# Leave blank to measure the provider's native dimension on first use.
EMBEDDING_DIMENSIONS=

# Duplicate-incident rule. All three must pass.
SIMILARITY_THRESHOLD=0.80
GEO_RADIUS_METERS=500
TIME_WINDOW_HOURS=72

# Comma-separated frontend origins, or * for a class demo.
CORS_ORIGINS=*
